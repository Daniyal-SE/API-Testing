# ==============================================================================
# API Behavior Miner & Business-Logic Vulnerability Tester — Semester 7 Backend
# Copy to .env for local development. Never commit real credentials or keys.
# ==============================================================================

APP_NAME="API Behavior Miner (Semester 7)"
ENVIRONMENT="development"
API_V1_PREFIX="/api/v1"
DEBUG=false

# Database (PostgreSQL in Docker Compose; SQLite supported only for isolated unit/integration tests)
DATABASE_URL="postgresql+psycopg://abm_user:CHANGE_ME_DEV_DB_PASSWORD@localhost:5432/abm_sem7"

# Redis / RQ Queue
REDIS_URL="redis://localhost:6379/0"
RQ_QUEUE_NAME="abm_assessments"

# Security & Sessions
# Generate a strong random secret in real deployments (e.g. python -c "import secrets; print(secrets.token_urlsafe(48))")
SESSION_SECRET_KEY="CHANGE_ME_LOCAL_DEV_SESSION_SECRET_DO_NOT_USE_IN_PROD"
SESSION_TTL_MINUTES=480
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"
ALLOW_BEARER_HEADER=true
REGISTRATION_MODE="invite_only"
MIN_PASSWORD_LENGTH=10
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# CORS (explicit origins only, never wildcard with credentials)
CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]'

# Runner & Safe Execution Boundary
# Options: "local_restricted" (development/no-Docker host) or "docker" (restricted container)
RUNNER_MODE="local_restricted"
RUNNER_DOCKER_IMAGE="abm-safe-runner:sem7"
RUNNER_MAX_RESPONSE_BYTES=2097152
RUNNER_CONNECT_TIMEOUT_SECONDS=5.0
RUNNER_READ_TIMEOUT_SECONDS=10.0

# Platform-Enforced Budget Ceilings (SRS provisional bounds)
PLATFORM_MAX_CRAWL_DEPTH=8
PLATFORM_MAX_REQUESTS=5000
PLATFORM_MAX_RATE_RPS=20.0
PLATFORM_MAX_CONCURRENCY=10
PLATFORM_MAX_WALL_CLOCK_SECONDS=3600

# Logging
LOG_LEVEL="INFO"
